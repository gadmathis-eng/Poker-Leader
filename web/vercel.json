{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/support/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/table/:code",
      "destination": "/table/index.html"
    },
    {
      "source": "/table/:code/",
      "destination": "/table/index.html"
    }
  ]
}
